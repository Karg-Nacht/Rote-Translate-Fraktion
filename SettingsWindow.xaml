<Window x:Class="Rtf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rtf"
        Title="Rote Translate Fraktion — Settings" Width="688" Height="599"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource InterfaceFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="WindowKeyDown">
    <Grid x:Name="Chrome" Margin="12,10,12,15"
          TextElement.Foreground="{StaticResource Ink}">
        <Border x:Name="ShellShadow" Background="{StaticResource Graphite}" CornerRadius="15" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity=".48" Color="#101015"/>
            </Border.Effect>
        </Border>
        <Grid x:Name="Regions">
            <Border Background="{StaticResource MineralSurface}" IsHitTestVisible="False"/>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="224" Height="2"
                  Margin="0,1,15,0" ClipToBounds="True" IsHitTestVisible="False">
                <Border x:Name="EdgeHighlight" Width="96" Height="1" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Opacity="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00B3ADB0" Offset="0"/>
                            <GradientStop Color="#B3ADB0" Offset=".58"/>
                            <GradientStop Color="#00B3ADB0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="SettingsHeader" Margin="24,0">
                    <Grid Background="Transparent" Margin="0,0,44,0" MouseLeftButtonDown="DragHeader">
                        <DockPanel VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="9" Background="{StaticResource Field}"
                                    BorderBrush="{StaticResource Divider}" BorderThickness="1">
                                <Image Source="StandaloneCrystal.png" Width="32" Height="32" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Rote Translate Fraktion" Foreground="{StaticResource SecondaryInk}" FontSize="12"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="CancelClicked" ToolTip="Close"
                            AutomationProperties.Name="Close settings">
                        <Path Data="{StaticResource CloseGlyph}" Stroke="{StaticResource Bone}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>

                <local:SettingsTabControl x:Name="Tabs" Grid.Row="1" Margin="24,0"
                            KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="Settings tabs">
                    <TabItem Header="General">
                        <StackPanel Margin="0,2,0,4">
                            <Label Content="Translation priority" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ModePicker}"/>
                            <ComboBox x:Name="ModePicker" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      AutomationProperties.Name="Translation priority"/>
                            <TextBlock Text="Local AI mode only uses Ollama and LM Studio on this PC."
                                       Style="{StaticResource Hint}" Margin="0,7,0,17"/>
                            <Label Content="Fallback target language" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=TargetPicker}"/>
                            <local:SearchPicker x:Name="TargetPicker"
                                      AutomationProperties.Name="Fallback target language" Margin="0,0,0,17"
                                      ToolTip="In automatic mode, Russian text is translated into English and English text into Russian."/>
                            <Label Content="AI instructions" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=StyleInstructions}"/>
                            <TextBox x:Name="StyleInstructions" Height="96" Tag="Tone, terminology, and other preferences" MaxLength="1600" VerticalContentAlignment="Stretch"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="AI instructions"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="AI">
                        <StackPanel Margin="0,2,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Provider" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=AiPicker}"/>
                                    <ComboBox x:Name="AiPicker" DisplayMemberPath="Name" SelectionChanged="AiChanged"
                                              AutomationProperties.Name="AI provider"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Translation trigger" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=RequestPicker}"/>
                                    <ComboBox x:Name="RequestPicker" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              AutomationProperties.Name="Translation trigger"
                                              ToolTip="AI requests may use API credits."/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="AiEnabled" Style="{StaticResource Switch}" Content="Use for translation" Margin="0,8,0,12"/>
                            <Label Content="API key" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=AiKey}"/>
                            <PasswordBox x:Name="AiKey" AutomationProperties.Name="AI API key" Margin="0,0,0,12"/>
                            <Label Content="API URL" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=AiAddress}"/>
                            <TextBox x:Name="AiAddress" MaxLength="512" AutomationProperties.Name="AI API URL" Margin="0,0,0,12"/>
                            <Label Content="Model" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=AiModel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AiModel" MaxLength="512" Tag="Model ID" AutomationProperties.Name="Model name">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=ModelPicker}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <local:SearchPicker x:Name="ModelPicker" Placeholder="Select a model" Visibility="Collapsed"
                                          AutomationProperties.Name="Available models"/>
                                <Button x:Name="LoadModels" Grid.Column="1" Content="Models" Click="LoadModelsClicked"
                                        Margin="10,0,0,0" MinWidth="98" ToolTip="Load models from this provider"/>
                            </Grid>
                            <DockPanel Margin="0,9,0,0">
                                <ProgressBar x:Name="ModelsProgress" DockPanel.Dock="Left" Style="{StaticResource StatusProgress}"
                                             Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="AiHint" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
                            </DockPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Translation APIs">
                        <StackPanel Margin="0,2,0,4">
                            <Label Content="Services without an API key" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel Margin="0,0,0,19">
                                <CheckBox x:Name="UseGoogle" Content="Google Translate" Margin="0,0,24,0"/>
                                <CheckBox x:Name="UseMemory" Content="MyMemory"/>
                            </WrapPanel>
                            <CheckBox x:Name="GoogleLive" Style="{StaticResource Switch}" Content="Translate as you type with Google Translate"
                                      IsEnabled="{Binding IsChecked, ElementName=UseGoogle}" Margin="0,0,0,15"/>
                            <Label Content="Translation provider" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ApiPicker}"/>
                            <ComboBox x:Name="ApiPicker" DisplayMemberPath="Name" SelectionChanged="ApiChanged"
                                      AutomationProperties.Name="Translation provider" Margin="0,0,0,16"/>
                            <Label Content="API key" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=TranslatorKey}"/>
                            <PasswordBox x:Name="TranslatorKey" AutomationProperties.Name="Translation API key"/>
                            <StackPanel x:Name="ApiExtraFields" Visibility="Collapsed" Margin="0,16,0,0">
                                <Label x:Name="ApiExtraLabel" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ApiExtra}"/>
                                <TextBox x:Name="ApiExtra" MaxLength="512" AutomationProperties.LabeledBy="{Binding ElementName=ApiExtraLabel}"/>
                            </StackPanel>
                            <TextBlock Text="Leave a field blank to use the corresponding environment variable."
                                       Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </TabItem>
                </local:SettingsTabControl>

                <Border x:Name="SettingsFooter" Grid.Row="2" Margin="1,0,1,1" BorderBrush="{StaticResource Divider}"
                        BorderThickness="0,1,0,0" Background="{StaticResource Mineral}" CornerRadius="0,0,14,14">
                    <StackPanel Margin="23,10,23,11">
                        <TextBlock x:Name="DiscardPrompt" Text="Save changes before closing?"
                                   Style="{StaticResource Hint}" Foreground="{StaticResource Bone}" Margin="0,0,0,7"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                        <DockPanel>
                            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                    Content="Save" IsDefault="True" Click="SaveClicked"/>
                            <WrapPanel x:Name="DiscardActions" DockPanel.Dock="Right" Orientation="Horizontal"
                                       VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="KeepEditingButton" Content="Keep editing" Click="KeepEditingClicked"
                                        Margin="0,0,8,0" FontSize="13" Padding="10,0"/>
                                <Button Content="Discard changes" Click="DiscardClicked" Margin="0,0,8,0"
                                        FontSize="13" Padding="10,0"/>
                            </WrapPanel>
                            <TextBlock x:Name="Feedback" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Path x:Name="Outline" Stroke="{StaticResource Edge}" StrokeThickness="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
