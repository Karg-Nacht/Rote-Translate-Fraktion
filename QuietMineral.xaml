
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Rtf">
    <FontFamily x:Key="InterfaceFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>
    <SolidColorBrush x:Key="Graphite" Color="#222226"/>
    <SolidColorBrush x:Key="Mineral" Color="#302E32"/>
    <SolidColorBrush x:Key="Field" Color="#19191D"/>
    <SolidColorBrush x:Key="Ink" Color="#E8DED0"/>
    <SolidColorBrush x:Key="SecondaryInk" Color="#B3ADB0"/>
    <SolidColorBrush x:Key="Muted" Color="#A29C9F"/>
    <SolidColorBrush x:Key="Edge" Color="#514D51"/>
    <SolidColorBrush x:Key="Divider" Color="#3C3940"/>
    <SolidColorBrush x:Key="Bone" Color="#D9CCBA"/>
    <SolidColorBrush x:Key="Selection" Color="#736B70"/>
    <SolidColorBrush x:Key="SelectedSurface" Color="#3C373D"/>
    <SolidColorBrush x:Key="HoverFill" Color="#39373D"/>
    <SolidColorBrush x:Key="Tint" Color="#18E8DED0"/>
    <SolidColorBrush x:Key="WarningInk" Color="#E5B6A7"/>
    <ImageBrush x:Key="MineralGrain" ImageSource="MineralGrain.png"
                ViewportUnits="Absolute" Viewport="0,0,76,56" TileMode="FlipXY" Stretch="Fill" Opacity=".15"/>
    <DrawingBrush x:Key="MineralSurface" Viewbox="0,0,512,320" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H512 V320 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint=".85,1">
                            <GradientStop Color="#2A2A30" Offset="0"/>
                            <GradientStop Color="#24242A" Offset=".46"/>
                            <GradientStop Color="#222227" Offset=".78"/>
                            <GradientStop Color="#27272C" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M206,0 H512 V141 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint=".97,0" EndPoint=".3,.92">
                            <GradientStop Color="#0CC8C5D2" Offset="0"/>
                            <GradientStop Color="#03C8C5D2" Offset=".62"/>
                            <GradientStop Color="#00C8C5D2" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,130 L246,320 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,1" EndPoint=".76,.15">
                            <GradientStop Color="#1514121E" Offset="0"/>
                            <GradientStop Color="#0014121E" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H512 V320 H0 Z" Brush="{StaticResource MineralGrain}"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="MineralPopup" Viewbox="0,0,320,220" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H320 V220 H0 Z" Brush="{StaticResource Mineral}"/>
                <GeometryDrawing Geometry="M0,0 H320 V220 H0 Z" Brush="{StaticResource MineralGrain}"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <Geometry x:Key="Chevron">M 1,1 L 5,5 L 9,1</Geometry>
    <Geometry x:Key="CloseGlyph">M 1,1 L 11,11 M 11,1 L 1,11</Geometry>
    <Geometry x:Key="CheckGlyph">M 1,5 L 4,8 L 10,2</Geometry>
    <Geometry x:Key="SearchGlyph">M 7.8,7.8 L 11,11 M 9,5 A 4,4 0 1 1 1,5 A 4,4 0 1 1 9,5</Geometry>
    <SineEase x:Key="EaseOut" EasingMode="EaseOut"/>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <!-- Template overlays animate opacity so shared brushes stay immutable. -->
    <Style x:Key="InteractiveOverlay" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"
                                             EasingFunction="{StaticResource EaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Storyboard x:Key="FocusIn">
        <DoubleAnimation Storyboard.TargetName="FieldFocus" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="FocusOut">
        <DoubleAnimation Storyboard.TargetName="FieldFocus" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="0:0:0.14"/>
    </Storyboard>
    <Style x:Key="FocusRing" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bone}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Storyboard x:Key="HoverIn">
        <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    <Storyboard x:Key="HoverOut">
        <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="0:0:0.14"/>
    </Storyboard>
    <Style x:Key="HoverTint" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Background" Value="{StaticResource Tint}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Mineral}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="MinHeight" Value="39"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Face" Background="Transparent" RenderTransformOrigin=".5,.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PressScale"/>
                        </Grid.RenderTransform>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                        <Border x:Name="HoverSurface" Style="{StaticResource HoverTint}"/>
                        <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To=".967" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To=".967" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13" EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value=".58"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Bone}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
        <Setter Property="Foreground" Value="{StaticResource Field}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinWidth" Value="104"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Bone}"/>
    </Style>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Field}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Selection}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="37"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="FieldSurface" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{StaticResource Muted}" Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="FieldSurface" Property="Background" Value="{StaticResource Graphite}"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Field}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Selection}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="37"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MaxLength" Value="1024"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderThickness="1" CornerRadius="5"
                            Padding="{TemplateBinding Padding}" ClipToBounds="True">
                        <DockPanel LastChildFill="True">
                            <Path x:Name="Mark" DockPanel.Dock="Right" Data="{StaticResource CheckGlyph}" Stroke="{StaticResource Bone}"
                                  StrokeThickness="1.4" VerticalAlignment="Center" Margin="8,0,1,0" Opacity="0"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedSurface}"/>
                            <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Edge}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="MinHeight" Value="37"/>
        <Setter Property="MaxDropDownHeight" Value="260"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border Background="{StaticResource Field}" CornerRadius="8"
                                                BorderBrush="{StaticResource Edge}" BorderThickness="1"/>
                                        <Border x:Name="HoverSurface" Style="{StaticResource HoverTint}"/>
                                        <Path Data="{StaticResource Chevron}" Stroke="{StaticResource Bone}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="12,0,35,0" ClipToBounds="True" IsHitTestVisible="False">
                            <ContentPresenter VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        </Grid>
                        <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}"/>
                        <Border Style="{StaticResource InteractiveOverlay}" BorderThickness="1" BorderBrush="{StaticResource Bone}"
                                Tag="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" Focusable="False"
                               VerticalOffset="4">
                            <Border Background="{StaticResource MineralPopup}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    CornerRadius="8" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="5"/>
                            <Border x:Name="CheckFill" Style="{StaticResource InteractiveOverlay}"
                                    Tag="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="5"
                                    Background="{StaticResource Bone}">
                                <Path Data="{StaticResource CheckGlyph}" Stroke="{StaticResource Field}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="HoverSurface" Style="{StaticResource HoverTint}" CornerRadius="5"/>
                            <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}" CornerRadius="5" Margin="-2"/>
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".53"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource SecondaryInk}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent" MinHeight="43">
                        <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}" Margin="4,5"/>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            <ContentPresenter x:Name="HoverSurface" ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.Foreground="{StaticResource Ink}" IsHitTestVisible="False"
                                              Opacity="0"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton x:Name="Decrease" Command="{x:Static ScrollBar.PageUpCommand}"
                                          Style="{StaticResource ScrollTrackButton}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Focusable="False" MinWidth="0" MinHeight="0">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Border x:Name="Handle" Width="5" HorizontalAlignment="Center"
                                                    Margin="0,1" Background="{StaticResource Selection}" CornerRadius="2.5"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                                                <Setter TargetName="Handle" Property="Background" Value="{StaticResource Muted}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Handle" Property="Background" Value="{StaticResource Bone}"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Handle" Property="Background" Value="{StaticResource Bone}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                                                <Setter TargetName="Handle" Property="Width" Value="Auto"/>
                                                <Setter TargetName="Handle" Property="Height" Value="5"/>
                                                <Setter TargetName="Handle" Property="Margin" Value="1,0"/>
                                                <Setter TargetName="Handle" Property="HorizontalAlignment" Value="Stretch"/>
                                                <Setter TargetName="Handle" Property="VerticalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton x:Name="Increase" Command="{x:Static ScrollBar.PageDownCommand}"
                                          Style="{StaticResource ScrollTrackButton}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="Decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                            <Setter TargetName="Increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="11"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Margin="{TemplateBinding Padding}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Style="{StaticResource {x:Type ScrollBar}}" Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1"
                                   Style="{StaticResource {x:Type ScrollBar}}" Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerOptionList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Style="{StaticResource {x:Type ScrollViewer}}" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerOptionRow" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="5" Background="Transparent" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedSurface}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Bone}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:SearchPicker">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="37"/>
        <Setter Property="Padding" Value="12,0,11,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SearchPicker">
                    <Grid>
                        <Button x:Name="PART_Anchor" Background="{TemplateBinding Background}" Focusable="False"
                                IsTabStop="False" MinHeight="0" BorderThickness="{TemplateBinding BorderThickness}"
                                Style="{StaticResource {x:Type Button}}" BorderBrush="{TemplateBinding BorderBrush}"
                                Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="{StaticResource Chevron}" Stroke="{StaticResource Bone}"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="7,0,0,0"/>
                                <TextBlock x:Name="Caption" Text="{TemplateBinding Caption}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}"/>
                        <Border Style="{StaticResource InteractiveOverlay}" BorderThickness="1" BorderBrush="{StaticResource Bone}"
                                Tag="{Binding IsOpen, ElementName=PART_Popup}"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=PART_Anchor}" Placement="Bottom" VerticalOffset="4" Focusable="False">
                            <Border Background="{StaticResource MineralPopup}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    CornerRadius="10" Padding="6" MinWidth="208" TextElement.FontSize="13"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    KeyboardNavigation.TabNavigation="Cycle">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                                        <TextBox x:Name="PART_Search" Tag="Search" Padding="29,5,8,5" MinHeight="32"
                                                 AutomationProperties.Name="Search options"/>
                                        <Path Data="{StaticResource SearchGlyph}" Stroke="{StaticResource Muted}" StrokeThickness="1.15"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                              IsHitTestVisible="False"/>
                                    </Grid>
                                    <Grid>
                                        <ListBox x:Name="PART_Options" Style="{StaticResource PickerOptionList}"
                                                 ItemContainerStyle="{StaticResource PickerOptionRow}" MaxHeight="220"
                                                 AutomationProperties.Name="Available options">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Path DockPanel.Dock="Right" Data="{StaticResource CheckGlyph}" Stroke="{StaticResource Bone}"
                                                              StrokeThickness="1.4" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Opacity" Value="0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{x:Static local:SelectedOptionConverter.Instance}">
                                                                                    <Binding/>
                                                                                    <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Label}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="No results found" Foreground="{StaticResource SecondaryInk}" Margin="9,8"
                                                   IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=PART_Options}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Caption" Value="{x:Null}">
                            <Setter TargetName="Caption" Property="Text" Value="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource Muted}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource FocusOut}"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusProgress" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" Background="{StaticResource Divider}" CornerRadius="1.5" ClipToBounds="True">
                        <Border Width="10" HorizontalAlignment="Left" Background="{StaticResource Bone}" CornerRadius="1.5">
                            <Border.RenderTransform><TranslateTransform x:Name="Pulse"/></Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="ProgressMotion">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="X"
                                                         From="0" To="18" AutoReverse="True" Duration="0:0:0.5"
                                                         EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ProgressMotion"/></MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource MineralPopup}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                            CornerRadius="7" Padding="10,7">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource MineralPopup}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                            CornerRadius="8" Padding="4">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Padding="9,6" Background="Transparent" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="22,0,0,0"
                                       Foreground="{StaticResource SecondaryInk}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value=".48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource Divider}" Margin="6,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ContextMenu x:Key="EditorMenu" x:Shared="False">
        <MenuItem Header="Undo" Command="ApplicationCommands.Undo"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <Separator/>
        <MenuItem Header="Cut" Command="ApplicationCommands.Cut"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="Copy" Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="Paste" Command="ApplicationCommands.Paste"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <Separator/>
        <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    </ContextMenu>

    <ContextMenu x:Key="ReadingMenu" x:Shared="False">
        <MenuItem Header="Copy" Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    </ContextMenu>
    <Style TargetType="local:SettingsTabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SettingsTabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="TabTrack" Margin="0,0,0,17">
                            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Divider}"/>
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"
                                      KeyboardNavigation.TabNavigation="Once"/>
                            <Border x:Name="TabIndicator" Width="0" Height="2" CornerRadius="1" Opacity="0"
                                    Background="{StaticResource Bone}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ScrollViewer x:Name="TabScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2" Margin="0,0,4,15"/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="33" Height="19" VerticalAlignment="Center">
                            <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="9.5"/>
                            <Border x:Name="TrackOn" Style="{StaticResource InteractiveOverlay}"
                                    Tag="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{StaticResource Bone}" CornerRadius="9.5"/>
                            <Border x:Name="Pip" Width="11" Height="11" CornerRadius="5.5"
                                    HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center"
                                    Background="{StaticResource SecondaryInk}">
                                <Border.RenderTransform><TranslateTransform x:Name="PipOffset"/></Border.RenderTransform>
                            </Border>
                            <Border x:Name="HoverSurface" Style="{StaticResource HoverTint}" CornerRadius="9.5"/>
                            <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}" Margin="-2" CornerRadius="11"/>
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pip" Property="Background" Value="{StaticResource Field}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PipOffset" Storyboard.TargetProperty="X"
                                                     To="14" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="PipOffset" Storyboard.TargetProperty="X"
                                                     To="0" Duration="0:0:0.14" EasingFunction="{StaticResource EaseOut}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource FocusOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".53"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent" MinHeight="26">
                        <Grid Width="19" Height="19" VerticalAlignment="Center">
                            <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}"
                                    BorderThickness="1" CornerRadius="9.5"/>
                            <Border Style="{StaticResource InteractiveOverlay}" Background="{StaticResource Bone}"
                                    Margin="5" CornerRadius="5"
                                    Tag="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="HoverSurface" Style="{StaticResource HoverTint}" CornerRadius="9.5"/>
                            <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}" CornerRadius="11" Margin="-2"/>
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource FocusOut}"/></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".53"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:PanelTextScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="CanContentScroll" Value="False"/>
        <Setter Property="PanningMode" Value="VerticalOnly"/>
    </Style>

    <Style x:Key="PanelEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="ContextMenu" Value="{StaticResource EditorMenu}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="SelectionOpacity" Value=".57"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <local:PanelTextScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}"/>
                        <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{StaticResource Muted}" Margin="{TemplateBinding Padding}" TextWrapping="Wrap"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource FocusOut}"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:MarkdownTextView">
        <Setter Property="ContextMenu" Value="{StaticResource ReadingMenu}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Selection}"/>
        <Setter Property="SelectionOpacity" Value=".57"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsUndoEnabled" Value="False"/>
        <Setter Property="IsDocumentEnabled" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MarkdownTextView">
                    <Grid>
                        <local:PanelTextScrollViewer x:Name="PART_ContentHost"/>
                        <Border x:Name="FieldFocus" Style="{StaticResource FocusRing}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource FocusIn}"/></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource FocusOut}"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
