<local:OverlayWindow x:Class="Rtf.TranslationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Rtf"
    Title="RTF translation" Width="508" Height="242" FontFamily="{StaticResource InterfaceFont}"
    WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <local:OverlayWindow.Resources>
        <Style x:Key="PanelIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource PanelIcon}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Width="12" Height="12">
                            <Path x:Name="Copy" Data="M3,3 H11 V11 H3 Z M1,8 V1 H8" Stroke="{StaticResource Bone}"
                                  StrokeThickness="1.1" StrokeLineJoin="Round"/>
                            <Path x:Name="Copied" Data="{StaticResource CheckGlyph}" Stroke="{StaticResource Bone}"
                                  StrokeThickness="1.4" Visibility="Collapsed"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                <Setter TargetName="Copy" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Copied" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Content" Value="Copy"/>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Bone}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReadingSurface" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Field}"/>
        </Style>
    </local:OverlayWindow.Resources>

    <Grid ClipToBounds="True" TextElement.Foreground="{StaticResource Ink}">
        <Path x:Name="Outline" Fill="{StaticResource MineralSurface}" Stroke="{StaticResource Edge}"
              StrokeThickness="1" IsHitTestVisible="False"/>
        <Grid x:Name="Regions">
            <Grid Margin="15,6,15,11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="39"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel x:Name="Header">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="CloseClicked" Focusable="False" ToolTip="Закрыть панель"
                            AutomationProperties.Name="Закрыть панель перевода">
                        <Path Data="{StaticResource CloseGlyph}" Stroke="{StaticResource Bone}" StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="SettingsClicked" Focusable="False" ToolTip="Настройки" AutomationProperties.Name="Настройки">
                        <Path x:Name="SettingsGlyph" Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin=".5,.5"
                              Stroke="{StaticResource Bone}" StrokeThickness="1.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,1.5 L 5.5,0 7.5,0 8,1.5 9.2,2 10.6,1.3 12,2.7 11.3,4.1 11.8,5.3 13.3,5.8 13.3,7.8 11.8,8.3 11.3,9.5 12,10.9 10.6,12.3 9.2,11.6 8,12.1 7.5,13.6 5.5,13.6 5,12.1 3.8,11.6 2.4,12.3 1,10.9 1.7,9.5 1.2,8.3 0,7.8 0,5.8 1.2,5.3 1.7,4.1 1,2.7 2.4,1.3 3.8,2 Z M 6.6,4.6 A 2.2,2.2 0 1 1 6.6,9 A 2.2,2.2 0 1 1 6.6,4.6 Z"/>
                    </Button>
                    <Button x:Name="ProviderSwitch" DockPanel.Dock="Right" Style="{StaticResource CompactButton}" MinWidth="35"
                            Margin="0,0,5,0" VerticalAlignment="Center" Click="SwitchProviderClicked" Focusable="False"
                            ToolTip="Переключиться на Google Translate"
                            AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                        <Path Data="M1,3 H12 L9,0 M12,8 H1 L4,11" Stroke="{StaticResource Bone}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Border Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="StartDrag"
                            MouseMove="MoveDrag" MouseLeftButtonUp="EndDrag" LostMouseCapture="DragCaptureLost">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="24" Height="24" Margin="0,0,7,0" Source="StandaloneCrystal.png" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="PanelTitle" Text="Rote Translate Fraktion" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource Divider}"/>
                <Grid x:Name="Body" Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button x:Name="CopyOriginal" DockPanel.Dock="Right" Style="{StaticResource CopyButton}"
                                Click="CopyOriginalClicked" ToolTip="Копировать оригинал" AutomationProperties.Name="Копировать оригинал"/>
                        <Button x:Name="PreviewOriginal" DockPanel.Dock="Right" Style="{StaticResource PanelIcon}" Margin="0,0,3,0"
                                FontSize="10" FontWeight="SemiBold" Content="MD" Click="PreviewOriginalClicked"
                                ToolTip="Показать Markdown оригинала"
                                AutomationProperties.Name="Переключить редактор и Markdown оригинала"/>
                        <Button x:Name="ClearOriginal" DockPanel.Dock="Right" Style="{StaticResource PanelIcon}" Margin="0,0,3,0"
                                Click="ClearOriginalClicked" ToolTip="Очистить исходный текст" AutomationProperties.Name="Очистить исходный текст">
                            <Path Data="M1,3 H13 M5,3 V1 H9 V3 M3,5 L4,13 H10 L11,5 M6,6 V10 M8,6 V10"
                                  Stroke="{StaticResource Bone}" StrokeThickness="1.15" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <TextBlock Text="Оригинал" Style="{StaticResource PanelLabel}"/>
                    </DockPanel>

                    <Border Grid.Row="1" Margin="0,5,0,0" Style="{StaticResource ReadingSurface}">
                        <Grid>
                            <TextBox x:Name="Original" Style="{StaticResource PanelEditor}" AcceptsReturn="True" TextWrapping="Wrap"
                                     Tag="Введите или вставьте текст" SpellCheck.IsEnabled="False" PreviewMouseDown="FocusContent"
                                     TextChanged="OriginalChanged" AutomationProperties.Name="Исходный текст"/>
                            <local:MarkdownTextView x:Name="OriginalPreview" Visibility="Collapsed"
                                                    PreviewMouseDown="FocusContent" AutomationProperties.Name="Markdown оригинала"/>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Column="2">
                        <Button x:Name="CopyTranslation" DockPanel.Dock="Right" Style="{StaticResource CopyButton}"
                                Click="CopyTranslationClicked" ToolTip="Копировать перевод" AutomationProperties.Name="Копировать перевод"/>
                        <local:SearchPicker x:Name="TargetLanguage" DockPanel.Dock="Right" MinWidth="65" MaxWidth="124"
                                            MinHeight="24" Margin="0,0,4,0" Padding="8,0" FontSize="11"
                                            AutomationProperties.Name="Язык перевода"/>
                        <TextBlock Text="Перевод" Style="{StaticResource PanelLabel}"/>
                    </DockPanel>

                    <Border Grid.Row="1" Grid.Column="2" Margin="0,5,0,0" Style="{StaticResource ReadingSurface}">
                        <Grid>
                            <local:MarkdownTextView x:Name="Translation" PreviewMouseDown="FocusContent"
                                                    AutomationProperties.Name="Текст перевода"/>
                            <StackPanel VerticalAlignment="Top" Margin="10,7">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RawText, ElementName=Translation}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <DockPanel>
                                    <ProgressBar x:Name="TranslationProgress" DockPanel.Dock="Left" Style="{StaticResource StatusProgress}"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TranslationStatus" FontSize="13" Foreground="{StaticResource SecondaryInk}"
                                               TextWrapping="Wrap" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite"/>
                                </DockPanel>
                                <Button x:Name="TranslationRetry" Style="{StaticResource CompactButton}" Content="Повторить"
                                        Click="RetryTranslationClicked" Visibility="Collapsed" Focusable="False"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,7,0,0">
                        <Button x:Name="TranslateButton" DockPanel.Dock="Right" Style="{StaticResource CompactPrimaryButton}"
                                Click="TranslateClicked" Content="Перевести" AutomationProperties.Name="Перевести"/>
                        <TextBlock x:Name="TranslationProvider" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource SecondaryInk}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
            </Grid>
            <Thumb x:Name="HeightGrip" Height="10" VerticalAlignment="Bottom" Cursor="SizeNS"
                   DragStarted="StartResize" DragDelta="MoveResize" DragCompleted="EndResize"
                   AutomationProperties.Name="Изменить высоту панели">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="GripLine" Width="27" Height="2" Background="{StaticResource Edge}"
                                    CornerRadius="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripLine" Property="Background" Value="{StaticResource Bone}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Grid>
</local:OverlayWindow>
